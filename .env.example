# Optional local overrides. You almost certainly do not need this file.
#
#   cp .env.example .env
#
# The local stack runs with no .env at all: docker-compose.local.yml supplies a
# committed dev Y-Sweet keypair and points storage at MinIO, so
#
#   docker compose -f docker-compose.yml -f docker-compose.local.yml up --build
#
# works on a fresh clone. This file is only for pointing that stack at
# something real - your own sync credentials, or a live S3 bucket instead of the
# stand-in.
#
# PRODUCTION CONFIG IS NOT HERE. The box's environment is generated by
# Terraform in https://github.com/jacobanana/mixedmode-deploy and written
# straight onto the machine over SSH; it is never copied from a file in this
# repo. Domains, the analytics subdomain and the Umami secrets left with it -
# analytics is a platform service on that box now, not a compose profile here.

# ---- Y-Sweet auth -----------------------------------------------------------
# Generate ONE keypair:
#   docker run --rm ghcr.io/jamsocket/y-sweet:latest y-sweet gen-auth --json
#
#   private_key  -> Y_SWEET_AUTH (the sync server verifies client tokens with it)
#   server_token -> goes inside YSWEET_CONNECTION_STRING below
#
# The connection string is the ROOT credential for the sync server. It stays
# between the api and ysweet containers and must never reach a browser - the
# api mints short-scoped per-board client tokens from it (POST /api/token).
Y_SWEET_AUTH=REPLACE_WITH_private_key
YSWEET_CONNECTION_STRING=ys://REPLACE_WITH_server_token@ysweet:8080

# ---- S3-compatible storage ----------------------------------------------------
# One bucket for both Y-Sweet document persistence (under /ysweet) and
# uploaded images (under /assets). Any S3-compatible provider works.
S3_BUCKET=my-mathsboard-bucket
Y_SWEET_STORE=s3://my-mathsboard-bucket/ysweet
S3_ASSET_PREFIX=assets/
AWS_ACCESS_KEY_ID=REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME
AWS_REGION=us-east-1
# AWS itself: https://s3.<region>.amazonaws.com - other providers: see their docs.
AWS_ENDPOINT_URL_S3=https://s3.us-east-1.amazonaws.com
# false on AWS; true for MinIO and most other S3-compatible providers.
AWS_S3_USE_PATH_STYLE=false
