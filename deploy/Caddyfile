# The LOCAL stack's Caddy: one plain-HTTP site on :8080 doing everything.
#
# Bind-mounted over the image's own deploy/web.Caddyfile by docker-compose.yml,
# and used by nothing else. Production is a different shape entirely — the edge
# proxy in the mixedmode-deploy repo terminates TLS, routes the two board
# domains and proxies /api and /ys; the image serves files and nothing more.
#
#   docker compose -f docker-compose.yml -f docker-compose.local.yml up --build
#   http://localhost:8080
#
# The language board is reached at :8080/language/ here, off the same build —
# the path-based layout that dev, the e2e suite and the GitHub Pages build all
# share. Its own-domain routing is a production concern and lives with the
# production config; that split is not new, and the Playwright suite has never
# covered the language domain (it loads `/`).

:8080 {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:8787
	}

	handle_path /ys/* {
		reverse_proxy ysweet:8080
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
