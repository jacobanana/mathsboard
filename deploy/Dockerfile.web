# Build the static frontend, then serve it with Caddy.
#
# Static files only: TLS, routing and the /api + /ys proxying belong to the edge
# stack in the mixedmode-deploy repo, which is what lets this box serve other
# apps on the same two ports. deploy/web.Caddyfile is baked in below, so a
# production routing change is an image build like any other change.
#
# The local stack has no edge proxy in front of it, so docker-compose.yml
# bind-mounts deploy/Caddyfile over the baked one and gets a single Caddy doing
# everything on :8080.

FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY tsconfig.json tsconfig.node.json vite.config.ts index.html ./
# The language board is a second Vite page (language/index.html served at
# /language/ — see vite.config.ts rollupOptions.input). It's a build entry, so
# it must be in the context or the multi-page build can't resolve it.
COPY language ./language
# The About page (burger menu) imports this repo-root doc verbatim via Vite's
# `?raw` (src/ui/About.tsx), so it must be in the build context. Copied before
# src so edits to src/ don't bust this layer.
COPY ABOUT.md ./
# Static PWA assets (manifests, home-screen icons, service worker) that Vite
# copies verbatim into dist. Without this the installable-app metadata is
# missing from the VPS build.
COPY public ./public
COPY src ./src
# Passed by publish.yml (see .github/actions/app-version); Vite bakes any VITE_*
# env var into the bundle. Placed just before the build so the npm ci layer
# above stays cached when only the version changes.
ARG APP_VERSION=dev
ENV VITE_APP_VERSION=$APP_VERSION
# Umami analytics (optional). Umami runs on its own subdomain, so the tracker URL
# is an absolute, deployment-specific value - both it and the website id are
# passed as build-args by publish.yml from repo variables. Empty by default ->
# src/analytics.ts requires both, so nothing loads unless they're set.
ARG UMAMI_SRC=
ARG UMAMI_WEBSITE_ID=
ENV VITE_UMAMI_SRC=$UMAMI_SRC
ENV VITE_UMAMI_WEBSITE_ID=$UMAMI_WEBSITE_ID
RUN npm run build

FROM caddy:2-alpine
COPY --from=build /app/dist /srv
COPY deploy/web.Caddyfile /etc/caddy/Caddyfile
